# ULTRON OS API Configuration
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=5000
API_HOST=0.0.0.0

# Local AI
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Voice mode: offline | online | auto
# auto = online when OPENAI_API_KEY is configured, otherwise offline
ULTRON_VOICE_MODE=auto

# Online OpenAI configuration
# Replace the placeholder with your real API key.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TIMEOUT=120
